# Core app settings
APP_NAME=refleks-worker
APP_ENV=production
APP_VERSION=dev
LOG_LEVEL=info

WORKER_TIMEZONE=UTC
WORKER_JOB_TIMEOUT=45m
WORKER_RUN_ON_STARTUP=true

# Shared Supabase database
SUPABASE_DB_URL=postgresql://user:password@host:5432/postgres?sslmode=require

# Internal schedules (5-field cron expressions)
# These are seed defaults — once the worker runs, schedules are managed
# in the worker_job_config database table and can be changed live.
BENCHMARK_SYNC_CRON=*/10 * * * *
SCENARIO_STATS_CRON=0 */12 * * *
LEADERBOARD_CRON=0 4 * * *
LEADERBOARD_MAX_RANK=1000

# How often the worker reconciles worker_job_config into the in-memory scheduler
CONFIG_SYNC_CRON=*/2 * * * *

# Benchmark source file mounted inside the worker container
BENCHMARK_SYNC_SOURCE_DIR=/data/benchmarks
BENCHMARK_SYNC_SOURCE_FILE=benchmarks_data.json
